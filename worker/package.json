{
  "name": "@play-seed/worker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log WRANGLER_SEND_METRICS=false wrangler dev --local --port 8787 --persist-to .wrangler/state",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log WRANGLER_SEND_METRICS=false wrangler deploy",
    "clean": "rimraf dist .wrangler"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "wrangler": "4.24.3"
  }
}
